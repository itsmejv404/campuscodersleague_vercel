generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PARTICIPANT
  VOTER
}

enum Category {
  CS
  NonCS
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role     @default(VOTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  votes     Vote[]

  @@map("users")
}

model Participant {
  id          String       @id @default(cuid())
  studentId   String       @unique
  name        String
  email       String       @unique
  gender      String
  phone       String
  year        String
  category    Category
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submissions Submission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId])
  @@map("participants")
}

model Team {
  id                     String        @id @default(cuid())
  name                   String        @unique
  createdByParticipantId String
  createdAt              DateTime      @default(now())
  members                Participant[]
  votes                  Vote[]
  submission             Submission?

  @@map("teams")
}

model Submission {
  id                       String       @id @default(cuid())
  teamId                   String       @unique
  team                     Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pdfUrl                   String
  fileName                 String
  fileSize                 Int
  submittedByUserId        String?
  submittedByParticipantId String?
  submittedBy              Participant? @relation(fields: [submittedByParticipantId], references: [id], onDelete: SetNull)
  submitterName            String
  submitterEmail           String
  submitterStudentId       String?
  submittedAt              DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  submissionCount          Int          @default(1)

  @@index([teamId])
  @@map("submissions")
}

model Vote {
  id          String   @id @default(cuid())
  teamId      String
  voterUserId String
  createdAt   DateTime @default(now())
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  voter       User     @relation(fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([teamId, voterUserId])
  @@index([voterUserId])
  @@index([teamId])
  @@map("votes")
}

model VotingWindow {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("voting_windows")
}

model SubmissionWindow {
  id        String    @id @default(cuid())
  isOpen    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("submission_windows")
}

model OtpToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_tokens")
}
